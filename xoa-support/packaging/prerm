# prerm: remove the sos plugin copy on package removal.
set -e
SOS_PLUGIN_DIR=/usr/lib/python3/dist-packages/sos/report/plugins
rm -f "$SOS_PLUGIN_DIR/xoa.py"
rm -rf /usr/lib/python3/dist-packages/xoa_support
exit 0
